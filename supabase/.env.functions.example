# Server side secrets for Supabase edge functions.
#
# Copy to supabase/.env.functions, fill in, then push with:
#   make secrets-push
#
# supabase/.env.functions is gitignored. This template is committed.
#
# These never reach the client. Unlike the root .env, which is compiled into the
# app binary, everything here stays on Supabase's servers.
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into every function automatically and must not be listed here.

# Google AI Studio: https://aistudio.google.com/apikey
# Used by the analyze-plate function for vision analysis.
GEMINI_API_KEY=

# Overrides the vision model. Google retires models on a rolling schedule, so
# this exists to move models without a code change.
GEMINI_MODEL=

# Used only when the primary model is busy, times out, or returns empty text.
# Keep this on a stable flash model so a flake on the primary does not fail
# the scan in front of the user.
GEMINI_FALLBACK_MODEL=

# Comma separated browser origins allowed to call analyze-plate. Leave empty for
# a mobile only build: native clients send no Origin header and do not enforce
# CORS, so no origin needs to be allowed.
ALLOWED_ORIGINS=

# RevenueCat webhook verification. Two independent mechanisms; the signing
# secret is preferred and takes precedence when both are set.
#
# HMAC signing secret. Generated by RevenueCat when you enable signing on the
# webhook integration, so it must be copied from there rather than chosen.
REVENUECAT_SIGNING_SECRET=

# Static Authorization header value, used only when no signing secret is set.
# Weaker: it does not bind the secret to the request body.
REVENUECAT_WEBHOOK_SECRET=

# Required for sandbox/App Review purchases. Production subscription state
# cannot be overwritten by sandbox events. Disable if sandbox access is unwanted.
REVENUECAT_ALLOW_SANDBOX=true

# When true, analyze-plate skips consume_scan_credit if the debug client sends
# x-evenplate-dev-unlimited: 1. Leave false (or unset) in production.
ALLOW_DEV_UNLIMITED_SCANS=false

# Same Sentry DSN as the app. analyze-plate reports Gemini outages here.
# Leave blank to keep function reports in the Supabase log only.
# Never send photos or email.
SENTRY_DSN=

REVENUECAT_SECRET_API_KEY=

ONESIGNAL_REST_API_KEY=

ONESIGNAL_APP_ID=

# Optional legacy nutrient-catalog maintenance: USDA FoodData Central server key for sourced nutrient lookup.
USDA_API_KEY=

# Apple DeviceCheck signing credentials, server-side only.
# Base64 encode the complete .p8 PEM file; never include it in the client .env.
DEVICECHECK_PRIVATE_KEY_BASE64=
DEVICECHECK_KEY_ID=
DEVICECHECK_TEAM_ID=
