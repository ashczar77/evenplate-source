# EvenPlate build time configuration.
#
# Copy this file to .env and fill in real values, then run:
#   flutter run --dart-define-from-file=.env
#
# .env is gitignored. This template is committed; keep it free of real values.
#
# Everything in this file is compiled into the binary and is recoverable from a
# release build. Only publishable keys belong here. Server side secrets
# (GEMINI_API_KEY, REVENUECAT_WEBHOOK_SECRET) are Supabase function secrets and
# must never be added to this file. See README.md for the full walkthrough.

# Supabase: Project Settings > API.
# Use the anon public key. Never the service_role key, which bypasses RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# RevenueCat: Project Settings > API keys.
# Use the public SDK keys (appl_... and goog_...), never a secret sk_ key.
# test_... Test Store keys work in debug / simulator only. A release
# install on a real phone will show "Wrong API Key" and quit.
REVENUECAT_APPLE_KEY=
REVENUECAT_GOOGLE_KEY=

# OneSignal: Settings > Keys & IDs. Leave blank to run in local simulation mode.
ONESIGNAL_APP_ID=

# Sentry: Project Settings > Client Keys (DSN). Leave blank to keep
# crash and feature reports local (debugPrint only).
SENTRY_DSN=

# Optional. Overrides the functions base URL.
# Leave blank to derive it from SUPABASE_URL.
BACKEND_ENDPOINT_URL=
